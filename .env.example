# CampusGent AI Environment Variables Template

# Node Environment (development, production, test)
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/campusgent

# JWT Secret Keys (Must be cryptographically strong in production)
JWT_SECRET=your_jwt_access_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key

# Frontend Allowed URL (CORS origin)
CLIENT_URL=http://localhost:5173

# Database Seeding (Set to 'true' to auto-seed demo accounts on initial production deploy)
AUTO_SEED=true
ALLOW_SEED_IN_PRODUCTION=true

# AI / LLM Configurations (Google Gemini OpenAI-compatible API)
AI_API_KEY=your_gemini_api_key
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-1.5-flash

# Frontend API URL (Set in Vercel/frontend environment to point to deployed backend)
VITE_API_URL=https://your-server-name.onrender.com/api/v1

