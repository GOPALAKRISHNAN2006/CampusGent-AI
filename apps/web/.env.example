# CampusGent AI - Web Frontend Environment Variables

# Backend API Base URL
# For local development (Vite proxy forwards /api to http://localhost:5000):
# VITE_API_URL=/api/v1

# For production deployment (e.g., hosted on Vercel connecting to Render backend):
# VITE_API_URL=https://your-server-name.onrender.com/api/v1
